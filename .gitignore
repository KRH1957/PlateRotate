# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Un-ignore the proxy server's compiled output — it must be committed so
# xCloud can run it without needing TypeScript installed
!proxy/dist/
!proxy/dist/server.js

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env contains the Anthropic API key, never commit it
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
