# PlateRotate Proxy — Environment Variables
# Copy this file to .env on your xCloud server and fill in the values.
# NEVER commit the .env file to git.

# Your Anthropic API key — get this from console.anthropic.com
# IMPORTANT: Generate a NEW key. The old key was baked into the APK and is compromised.
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_NEW_KEY_HERE

# App token — must match EXPO_PUBLIC_APP_TOKEN in the PlateRotate app's .env file
# This is the shared password that proves requests are coming from the app.
APP_TOKEN=PASTE_THE_TOKEN_FROM_THE_APP_ENV_FILE_HERE

# Port — most cloud hosts set this automatically via the PORT env var. Leave as 3000 if unsure.
PORT=3000
