# PlateRotate Proxy — Environment Variables
# Copy this file to .env for local dev. Set these same vars in Railway's Variables panel.
# NEVER commit the .env file to git.

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Your Anthropic API key — get this from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ─── App Auth ─────────────────────────────────────────────────────────────────
# Shared secret that proves requests are coming from the PlateRotate app.
# Must match EXPO_PUBLIC_APP_TOKEN in the app's .env file.
APP_TOKEN=PASTE_THE_TOKEN_FROM_THE_APP_ENV_FILE_HERE

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Your Stripe secret key — get this from dashboard.stripe.com/apikeys
# Use sk_live_... for production. Use sk_test_... for testing.
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE

# Stripe Price IDs — create these in the Stripe Dashboard first:
#   1. Go to dashboard.stripe.com/products
#   2. Create a product "PlateRotate Basic" with price $2.99/month (recurring)
#      Copy the Price ID that starts with price_ and paste it below.
#   3. Create a product "PlateRotate Pro" with price $5.99/month (recurring)
#      Copy the Price ID and paste it below.
STRIPE_PRICE_BASIC_MONTHLY=price_YOUR_BASIC_PRICE_ID_HERE
STRIPE_PRICE_PRO_MONTHLY=price_YOUR_PRO_PRICE_ID_HERE

# ─── Server ───────────────────────────────────────────────────────────────────
# Most cloud hosts set PORT automatically. Leave as 3000 if running locally.
PORT=3000
